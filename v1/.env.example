# 智能日报生成器（sdr）环境变量样例 —— 只放键名，禁止填入任何真实值
# 复制为 .env 后按需填写；.env 已被 .gitignore 排除，不入仓

# GitHub 提交采集（FR-01）：个人访问令牌，需仓库读取权限
GITHUB_TOKEN=

# 飞书任务采集（FR-02）：自建应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书用户身份授权（可选）：回调地址需与开发者后台「安全设置 → 重定向 URL」一致，
# 缺省为 http://localhost:8787/callback；token 文件缺省 data/feishu-tokens.json（不入仓）
SDR_FEISHU_REDIRECT_URI=
SDR_FEISHU_TOKEN_FILE=
# 授权时申请的权限范围（可选，缺省 task:task:read offline_access；
# 需在开发者后台开通 offline_access 才能拿到 refresh_token）
SDR_FEISHU_SCOPE=

# SMTP 邮件推送（FR-11）：端口为数字（如 587）
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SQLite 数据库文件路径（可选，默认 data/sdr.db，不入仓）
SDR_DB_PATH=

# 每日推送时间（可选，HH:mm，默认 18:00）；修改后 serve 下一次轮询即生效
SDR_PUSH_TIME=

# 推送收件人（可选，逗号分隔；缺省发给 SMTP_FROM 自身）
SDR_NOTIFY_TO=
# 告警收件人（可选，逗号分隔；缺省发给 SMTP_FROM 自身）
SDR_ALERT_TO=

# 采集可选参数：GitHub 仓库（owner/name）与本地扫描根目录
SDR_GITHUB_REPO=
SDR_LOCAL_DIR=

# 当前调用者成员 id（history 权限校验用；也可用 --actor 指定）
SDR_ACTOR=
