# 智能日报生成器 v2 环境变量样例 —— 只放键名，禁止填入任何真实值
# 复制为 .env 后按需填写；.env 已被仓库根 .gitignore 排除，绝不入仓
# 说明：键名沿用 v1 的契约，v2 可按自己的决策增删（增删须回写 specs/proposal.md §5）

# GitHub 提交采集：个人访问令牌（只读 repo 权限即可）
GITHUB_TOKEN=

# 飞书任务采集：自建应用凭证
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书用户身份授权（可选）
SDR_FEISHU_REDIRECT_URI=
SDR_FEISHU_TOKEN_FILE=
SDR_FEISHU_SCOPE=

# SMTP 邮件推送
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 存储与调度
SDR_DB_PATH=
SDR_PUSH_TIME=

# 收件人（v2 待决策：是否改为按成员邮箱投递，见 HANDOVER §6）
SDR_NOTIFY_TO=
SDR_ALERT_TO=

# 采集参数
SDR_GITHUB_REPO=
SDR_LOCAL_DIR=

# 调用者身份（history 权限校验）
SDR_ACTOR=
